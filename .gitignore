# Secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data / warehouse / trade journal -- NEVER push these.
# Forks should start at zero; the data is proprietary.
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
bnpl-pod/data/*
!bnpl-pod/data/.gitkeep
!bnpl-pod/data/__init__.py
bnpl-pod/logs/**/*.jsonl
bnpl-pod/cache/
bnpl-pod/scripts/risk_engine_log.csv

# Reports with real P&L numbers / account-specific outputs
*PnL_report*.xlsx
*Progress_Report*.pdf
*_report.xlsx
*portfolio_export*.csv

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Fonts (large binaries, not needed in repo — users fetch locally)
fonts/

# Claude Code runtime artifacts (project launch config is tracked; lock files are not)
.claude/scheduled_tasks.lock
.claude/sessions/
.claude/cache/

# Per-machine Claude workspace noise inside the pod tree (never committed)
bnpl-pod/.claude/

# Local rescue backups (paranoia copies of the working tree; never committed)
bnpl-pod-rescue-backup-*/

# Design-brief archives (kept locally, not in version control)
BNPL pod design.zip
_design_unpack/
